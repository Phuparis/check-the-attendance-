# คัดลอกไฟล์นี้เป็น .env แล้วกรอกค่าจริง (ห้าม commit ไฟล์ .env ขึ้น GitHub)
# บน Render ให้ใส่ค่าเหล่านี้ในหน้า Environment แทน

# ---- จำเป็น ----
# LINE Official Account Manager > ตั้งค่า > Messaging API
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=

# กุญแจลับของรหัสหมุนเวียน ใส่ค่าเดียวกับใน ESP32 (สร้างด้วย npm run secret)
BEACON_SECRET=

# ---- Google Sheets (แนะนำ ไม่งั้นข้อมูลหายตอน Render รีสตาร์ต) ----
# ID ของชีต คือส่วนตรงกลางของลิงก์ docs.google.com/spreadsheets/d/<ID>/edit
GOOGLE_SHEET_ID=
# เนื้อหาไฟล์ JSON ของ service account ทั้งไฟล์ (หรือแปลงเป็น base64 ก็ได้)
GOOGLE_SERVICE_ACCOUNT_JSON=

# ---- ไม่บังคับ ----
COMPANY_NAME=บริษัทของเรา
# เข้างานหลังเวลานี้ถือว่าสาย (เวลาไทย)
WORK_START=09:00

# ถ้าไม่ใส่ เซิร์ฟเวอร์จะขอ token จาก LINE เองด้วย Channel ID + secret (อายุ 30 วัน ขอใหม่ให้อัตโนมัติ)
LINE_CHANNEL_ACCESS_TOKEN=

# URL สาธารณะของเซิร์ฟเวอร์ ใช้ตั้ง Webhook URL ใน LINE ให้อัตโนมัติ
# บน Render ไม่ต้องใส่ เพราะ Render ใส่ RENDER_EXTERNAL_URL ให้เอง
PUBLIC_URL=

# หน้าเว็บจำลอง (ตอนใช้งานจริงกับพนักงานให้ตั้งเป็น false ไม่งั้นใครเปิดลิงก์ก็กดเช็คอินแทนได้)
SIMULATOR_ENABLED=true
# ผู้รับข้อความตอนกดหน้าเว็บจำลอง ถ้าไม่ใส่ใช้คนล่าสุดที่ทักแชท
LINE_DEMO_USER_ID=

PORT=3000
